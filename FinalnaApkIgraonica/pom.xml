<?xml version="1.0" encoding="UTF-8"?>

<!--
  ŠTA RADI OVAJ POM:
  Maven ovde zna verziju Jave/Spring Boot-a i sve biblioteke koje projekat koristi.
  Ako IntelliJ ne prepoznaje dependency, prvo uradi Maven Reload.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <!-- Verzija Spring Boot-a koju koristi ceo projekat. -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <!-- Osnovni identitet Maven projekta. -->
    <groupId>rs.blabla</groupId>
    <artifactId>blabla-igraonica</artifactId>
    <version>1.0.0</version>
    <name>BlaBla Igraonica</name>

    <properties>
        <!-- Minimalna Java verzija za build. Tvoj lokalni JDK može biti noviji. -->
        <java.version>17</java.version>
    </properties>

    <dependencies>
        <!-- Web/MVC/Tomcat: controller-i, HTTP rute i ugrađeni server. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Thymeleaf: server-side HTML template-i iz resources/templates. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-thymeleaf</artifactId>
        </dependency>

        <!-- JPA/Hibernate: Java entiteti + rad sa MySQL bazom. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- Security: login, OWNER/EMPLOYEE uloge i zaštita admin ruta. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <!-- Validation anotacije ako kasnije dodamo @NotBlank, @Email, itd. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- Mail: JavaMailSender za email potvrde roditeljima. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-mail</artifactId>
        </dependency>

        <!-- JDBC drajver za MySQL. -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Lombok smanjuje boilerplate: @Getter, @Setter, @Builder... -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Test biblioteke; ne utiču na normalno pokretanje aplikacije. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Omogućava Spring Boot build/run kroz Maven. -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
